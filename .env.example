# Application
APP_ENV=development
LOG_LEVEL=INFO

# AI model provider — configure when a provider is selected
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Market data — configure when providers are selected
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
KITE_API_KEY=
KITE_API_SECRET=

# Optional persistence — configure when storage is implemented
DATABASE_URL=
MARKET_DATA_DATABASE_PATH=.local/market_data.sqlite3

# Safety defaults
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
