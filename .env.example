# Application
APP_ENV=development
LOG_LEVEL=INFO

# AI model provider — configure when a provider is selected
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=REPLACE_WITH_LLM_PROVIDER_API_KEY

# OpenAI adapter (optional; supply OPENAI_API_KEY in the environment)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-6-luna

# Market data — configure when providers are selected
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=REPLACE_WITH_MARKET_DATA_API_KEY
KITE_API_KEY=REPLACE_WITH_KITE_API_KEY
KITE_API_SECRET=REPLACE_WITH_KITE_API_SECRET
KITE_ACCESS_TOKEN=REPLACE_WITH_KITE_ACCESS_TOKEN
KITE_INGESTION_MAXIMUM_CALENDAR_DAYS=365

# Optional persistence — configure when storage is implemented
DATABASE_URL=
MARKET_DATA_DATABASE_PATH=.local/market_data.sqlite3

# Safety defaults
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
